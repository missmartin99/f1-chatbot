# Copy to .streamlit/secrets.toml for local use (it is git-ignored),
# or paste the same lines into Streamlit Community Cloud -> App settings -> Secrets.
# NEVER commit your real key.

# --- Option A (default, free hosting): the RAG pipeline runs inside the Streamlit app ---
OPENAI_API_KEY = "sk-..."

# --- Option B: forward questions to a hosted n8n workflow instead ---
# BACKEND = "n8n"
# CHAT_API_URL = "https://YOUR-N8N-HOST/webhook/f1-rag-chat"
# CHAT_API_AUTH_HEADER = "X-Api-Key"
# CHAT_API_AUTH_VALUE = "change-me"
